# Resend (https://resend.com) — used to email new orders to the business.
# Create an API key in the Resend dashboard.
RESEND_API_KEY=

# Where new order invoices/notifications should be sent — your business inbox.
ORDER_RECEIVER_EMAIL=infopakitini@gmail.com

# The "from" address Resend sends AS. This CANNOT be a Gmail/Yahoo/Outlook
# address — Resend (and every email API) requires a domain you own and verify
# via DNS records, since you can't verify ownership of gmail.com.
# - While testing: use Resend's shared sandbox address below (works immediately,
#   no setup, delivers straight to ORDER_RECEIVER_EMAIL).
# - Once you own a domain: verify it in the Resend dashboard, then use
#   something like orders@yourdomain.com here.
# Either way, the order email's Reply-To is set to the customer's email, so
# replying from your Gmail inbox still reaches the customer directly.
FROM_EMAIL=onboarding@resend.dev
