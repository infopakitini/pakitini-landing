# Sends order emails through Gmail's own SMTP using an App Password — free,
# no domain to buy or verify, and mail genuinely comes from your real Gmail
# address (unlike a third-party email API's shared sandbox domain, which can
# only deliver to your own inbox until you verify a custom domain).
#
# Setup (one time):
# 1. On the Gmail account you want to send from, turn on 2-Step Verification:
#    https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (name it anything, e.g. "pakitini-landing") — copy the 16-character value
# 3. Use that account's address and that app password below.
GMAIL_USER=infopakitini@gmail.com
GMAIL_APP_PASSWORD=

# Display name on outgoing emails (the address is always GMAIL_USER above).
FROM_NAME=Pakitini

# Where new order notifications land — your business inbox.
ORDER_RECEIVER_EMAIL=infopakitini@gmail.com

# Optional: Meta (Facebook/Instagram) Pixel override. The live Pixel ID
# already lives in lib/product.config.js (PRODUCT.META_PIXEL_ID) — only set
# this if you need a DIFFERENT pixel for a specific deployment (e.g. staging).
# Get the ID from Meta Events Manager (business.facebook.com/events_manager2
# → your Pixel → Settings). Once active, a "Purchase" event fires
# automatically whenever an order completes successfully.
NEXT_PUBLIC_META_PIXEL_ID=
